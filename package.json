{
  "name": "@cocreate/mysql",
  "version": "1.3.0",
  "description": "Lightweight MySQL, MariaDB, and Aurora CRUD wrapper and multi-tenant state routing client for the CoCreate ecosystem.",
  "keywords": [
    "mysql",
    "mariadb",
    "aurora",
    "sql",
    "json",
    "crud-api",
    "abstract-crud",
    "database-abstraction",
    "multi-tenant",
    "multi-tenant-routing",
    "realtime-sync",
    "state-synchronization"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreate-app/CoCreate-mysql.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreate-app/CoCreate-mysql/issues"
  },
  "homepage": "https://cocreate.app/docs/mysql",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./distribution": "./dist/mongodb.js",
    "./installer": "./installer/mongodb.installer.js"
  },
  "devDependencies": {
    "@cocreate/webpack": "^1.6.2"
  },
  "dependencies": {
    "@cocreate/utils": "^1.44.3",
    "mysql2": "^3.23.1"
  }
}